    <string name="auto_saver_text">Battery at %d%%. Slower GPS and no contour lines from now on. You can turn it off in Settings.</string>
    <string name="auto_saver_phone_text">The phone\u2019s battery saver is on, so Sentrek\u2019s is too. Turn it off in Settings.</string>
