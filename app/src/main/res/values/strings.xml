    <string name="settings_auto_power">Automatic battery modes</string>
    <string name="settings_auto_hint">When you’re not charging, battery saver and then stamina mode turn on by themselves as the battery runs down. Battery saver also turns on with your phone’s own battery saver. If you turn a mode off yourself, it stays off until the battery has been charged above that level again.</string>
    <string name="auto_channel">Battery modes</string>
    <string name="auto_saver_title">Battery saver on</string>
    <string name="auto_saver_text">Battery at %d%%. Slower GPS and no contour lines from now on. You can turn it off in Settings.</string>
    <string name="auto_saver_phone_text">The phone\u2019s battery saver is on, so Sentrek\u2019s is too. Turn it off in Settings.</string>
    <string name="auto_stamina_title">Stamina mode on</string>
    <string name="auto_stamina_text">Battery at %d%%. Everything at the bare minimum to make it last. Turn it off in Settings > Advanced.</string>
    <string name="settings_gps">GPS</string>
    <string name="settings_gps_hint">How often the GPS checks your position. Less often saves battery.</string>
    <string name="settings_gps_screen">Map on screen</string>
    <string name="settings_gps_follow">Following a route, screen off</string>
    <string name="settings_gps_follow_hint">A shorter time warns you sooner when you leave the route.</string>
    <string name="settings_gps_record">Recording, screen off</string>
    <string name="settings_gps_record_hint">A longer time saves battery but makes the recorded track less detailed.</string>
    <string name="settings_gps_saver">Battery saver uses at least %1$s, %2$s and %3$s.</string>
    <string name="settings_battery_saver">Battery saver</string>
    <string name="settings_battery_saver_hint">For long trips. Slower GPS, a 30 fps map and no contour lines. Your theme and map stay as they are.</string>
    <string name="settings_lock_north">Lock map to north</string>
    <string name="settings_lock_north_hint">Keeps north at the top. You can also long-press the compass.</string>
    <string name="settings_trail_difficulty">Trail difficulty colours</string>
    <string name="settings_trail_difficulty_hint">In downloaded areas. Yellow is T1, red T2–T3 and blue T4–T6 on the SAC scale. Dotted lines are faint trails.</string>
    <string name="settings_off_route_vibration">Vibrate when off route</string>
    <string name="settings_off_route_vibration_hint">3 long buzzes when you leave the route, 2 short ones when you’re back on it.</string>
