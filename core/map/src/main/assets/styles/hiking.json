     0.5,
     14,
     2
    ],
    "line-dasharray": [
     "case",
     [
      "==",
      [
       "get",
       "intermittent"
      ],
      1
     ],
     [
      "literal",
      [
       2,
       2
      ]
     ],
     [
      "literal",
      [
