   }
  },
  {
   "id": "landcover-wood",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "wood"
   ],
   "paint": {
    "fill-color": "#bfd9a8",
    "fill-opacity": 0.8
   }
  },
  {
   "id": "landcover-grass",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
