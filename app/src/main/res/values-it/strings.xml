    <string name="settings_sos">SOS</string>
    <string name="settings_sos_hint">Un pulsante rosso sulla mappa, sopra il lucchetto. Mostra dove sei a caratteri grandi, con i pulsanti per chiamare o mandare un SMS di aiuto. Spegnilo per nascondere il pulsante.</string>
    <string name="settings_emergency_number">Numero da chiamare</string>
    <string name="settings_emergency_number_hint">Il numero che chiama la schermata SOS. Il 112 in Europa, il 911 in Nord America, il soccorso alpino o un amico.</string>
    <string name="settings_emergency_sms">SMS di emergenza</string>
    <string name="settings_emergency_sms_hint">Aggiunge alla schermata SOS un pulsante che invia un SMS con la tua posizione al contatto di emergenza, dopo una conferma. Senza contatto, scrive l\'SMS nell\'app dei messaggi.</string>
    <string name="breadcrumb_chip">SMS ogni %1$d min · %2$s</string>
    <string name="settings_emergency_contact">Contatto di emergenza</string>
    <string name="settings_emergency_contact_none">Nessuno: scegli ogni volta</string>
    <string name="settings_emergency_contact_hint">Chi riceve l’SMS con la tua posizione. Scegli qualcuno dai tuoi contatti.</string>
    <string name="settings_emergency_contact_remove">Rimuovi</string>
    <string name="settings_breadcrumbs">Invia la posizione via SMS durante la registrazione</string>
    <string name="settings_breadcrumbs_off">No</string>
    <string name="settings_breadcrumbs_every">Ogni %d min</string>
    <string name="settings_breadcrumbs_hint">Sentrek manda un SMS al tuo contatto di emergenza quando inizi a registrare, poi a questo intervallo, e quando ti fermi. Non serve internet, basta il segnale telefonico; se manca, riprova finché non c’è.</string>
    <string name="settings_breadcrumbs_cost_warning">Il tuo operatore potrebbe far pagare ogni SMS, anche all’estero.</string>
    <string name="settings_breadcrumbs_cost_title">Gli SMS possono costare</string>
    <string name="settings_breadcrumbs_cost_text">Sentrek invierà questi SMS da solo, dalla tua SIM. Ogni %1$d minuti, un’escursione di 8 ore fa circa %2$d SMS.</string>
    <string name="settings_breadcrumbs_cost_confirm">Attiva</string>
    <string name="settings_low_battery_sms">SMS quando la batteria è scarica</string>
    <string name="settings_low_battery_sms_hint">Al 15%, un altro SMS con la tua posizione, nel caso il telefono si spenga. Richiede gli SMS della posizione attivi.</string>
    <string name="settings_servers">Server</string>
    <string name="settings_servers_hint">Da dove Sentrek prende mappe e dati. Se gestisci una tua copia di uno di questi servizi, puoi usarla qui. Le zone scaricate da un server diverso potrebbero dover essere riscaricate.</string>
    <string name="settings_server_tiles">Tile della mappa</string>
    <string name="settings_server_tiles_hint">La mappa e i caratteri delle etichette, nel formato di OpenFreeMap.</string>
    <string name="settings_server_terrain">Terreno</string>
    <string name="settings_server_terrain_hint">Dati di altitudine (tile Terrarium) per l’ombreggiatura del rilievo, le curve di livello e le quote.</string>
    <string name="settings_server_trails">Dettagli dei sentieri</string>
    <string name="settings_server_trails_hint">Un server Overpass API. Fornisce difficoltà dei sentieri, rifugi e sorgenti per le zone che scarichi.</string>
